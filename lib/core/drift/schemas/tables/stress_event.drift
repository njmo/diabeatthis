CREATE TABLE stress_event (
  id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
  source TEXT NOT NULL,
  external_id TEXT,
  notes TEXT,
  ended_at INTEGER,
  stress_level TEXT NOT NULL CHECK (stress_level IN ('low', 'moderate', 'high')),
  occurred_at INTEGER NOT NULL,
  recorded_at INTEGER NOT NULL,
  CHECK (ended_at IS NULL OR ended_at > occurred_at),
  UNIQUE (source, external_id)
);
CREATE INDEX idx_stress_event_occurred_at ON stress_event(occurred_at);
