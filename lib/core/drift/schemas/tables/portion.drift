CREATE TABLE portion (
  id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
  name TEXT NOT NULL,
  unit_hint TEXT NOT NULL,
  is_synced BOOL NOT NULL DEFAULT 0,
  UNIQUE (name, unit_hint)
);

searchPortionsByName:
  SELECT * FROM portion
  WHERE name LIKE '%' || :q || '%'
  ORDER BY name ASC;

markPortionsAsSynced:
  UPDATE portion SET
    is_synced = 1

getAllPortions:
  SELECT * FROM portion
  ORDER BY name ASC;

countPortions:
  SELECT COUNT(*) AS count FROM portion;

deleteAllPortions:
  DELETE FROM portion;

portionById:
  SELECT * FROM portion
  WHERE id = :id;

portionByIds:
  SELECT * FROM portion
  WHERE id IN ?
  ORDER BY name ASC;

updatePortion:
  UPDATE portion SET
    name      = :name,
    unit_hint = :unitHint
  WHERE id = :id;

deletePortion:
  DELETE FROM portion
  WHERE id = :id;

insertPortion:
  INSERT INTO portion (
    name,
    unit_hint
  ) VALUES (
    :name,
    :unitHint
  );
