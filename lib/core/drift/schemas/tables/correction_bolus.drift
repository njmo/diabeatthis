CREATE TABLE correction_bolus (
  id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,

  source TEXT NOT NULL CHECK (source IN ('cloud', 'aaps')),
  external_id TEXT,

  created_at INTEGER NOT NULL,
  received_at INTEGER NOT NULL DEFAULT (CAST(strftime('%s','now') AS INTEGER) * 1000),

  insulin REAL
);

CREATE UNIQUE INDEX uq_correction_bolus_external_id
ON correction_bolus(source, external_id)
WHERE external_id IS NOT NULL;

CREATE INDEX idx_correction_bolus_created_at
ON correction_bolus(created_at);
