CREATE TABLE meal (
  id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
  name TEXT NOT NULL,

  planned_at INTEGER NOT NULL,

  status TEXT NOT NULL DEFAULT 'planned',

  notes TEXT,

  created_at INTEGER NOT NULL DEFAULT (CAST(strftime('%s','now') AS INTEGER) * 1000),
  updated_at INTEGER NOT NULL DEFAULT (CAST(strftime('%s','now') AS INTEGER) * 1000),

  is_synced BOOL NOT NULL DEFAULT 0,

  UNIQUE (name, planned_at)
);

CREATE TRIGGER meal_set_updated_at
AFTER UPDATE ON meal
FOR EACH ROW
WHEN
  OLD.name IS NOT NEW.name OR
  OLD.planned_at IS NOT NEW.planned_at OR
  OLD.status IS NOT NEW.status OR
  OLD.notes IS NOT NEW.notes
BEGIN
  UPDATE meal
  SET updated_at = CAST(strftime('%s','now') AS INTEGER) * 1000
  SET is_synced = 0
  WHERE id = OLD.id;
END;

markMealsAsSynced:
  UPDATE meal SET
    is_synced = 1
  WHERE id = :id;

allMeals:
  SELECT * FROM meal;

deleteMealById:
  DELETE FROM meal
  WHERE id = :id;