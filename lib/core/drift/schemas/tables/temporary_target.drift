CREATE TABLE temporary_target (
  source TEXT NOT NULL CHECK (source IN ('cloud', 'aaps')),
  external_id TEXT,

  created_at INTEGER NOT NULL,
  received_at INTEGER NOT NULL DEFAULT (CAST(strftime('%s','now') AS INTEGER) * 1000),

  nightscout_id TEXT,
  duration_minutes INTEGER,
  target_bottom REAL,
  target_top REAL,

  PRIMARY KEY (created_at)
);

CREATE INDEX idx_temporary_target_created_at
ON temporary_target(created_at);
