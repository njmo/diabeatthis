import 'meal.drift';

CREATE TABLE meal_template (
  id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
  name TEXT NOT NULL,

  notes TEXT,

  created_at INTEGER NOT NULL DEFAULT (CAST(strftime('%s','now') AS INTEGER) * 1000),
  updated_at INTEGER NOT NULL DEFAULT (CAST(strftime('%s','now') AS INTEGER) * 1000),

  is_favorite BOOL NOT NULL DEFAULT 0,
  created_from_meal_id INTEGER DEFAULT NULL REFERENCES meal (id) ON DELETE SET NULL,

  is_synced BOOL NOT NULL DEFAULT 0,

  UNIQUE (name)
);

CREATE TRIGGER meal_template_only_favorite_update
BEFORE UPDATE ON meal_template
FOR EACH ROW
WHEN
  OLD.name != NEW.name OR
  OLD.notes != NEW.notes OR
  OLD.created_at != NEW.created_at OR
  OLD.created_from_meal_id != NEW.created_from_meal_id OR
  OLD.is_synced != NEW.is_synced
BEGIN
  SELECT RAISE(ABORT, 'Only is_favorite can be updated in meal_template');
END;