CREATE TABLE glucose_reading (
  source TEXT NOT NULL CHECK (source IN ('cloud', 'aaps', 'xdrip')),
  external_id TEXT,

  created_at INTEGER NOT NULL,
  received_at INTEGER NOT NULL DEFAULT (CAST(strftime('%s','now') AS INTEGER) * 1000),

  sgv INTEGER NOT NULL CHECK (sgv >= 0),
  direction TEXT,
  type TEXT NOT NULL DEFAULT 'cgm' CHECK (type IN ('cgm', 'finger', 'sensor', 'manual', 'other')),
  measurement_id TEXT NOT NULL DEFAULT '',
  notes TEXT,

  PRIMARY KEY (created_at, type, measurement_id)
);

CREATE INDEX idx_glucose_reading_created_at
ON glucose_reading(created_at);
