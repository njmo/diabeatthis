import 'meal.drift';

CREATE TABLE meal_snapshot (
  id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
  meal_id INTEGER NOT NULL
    REFERENCES meal(id) ON DELETE CASCADE,

  snapshot_type TEXT NOT NULL CHECK (snapshot_type IN (
    'planned',
    'consumed'
  )),

  total_grams REAL NOT NULL CHECK (total_grams >= 0),
  total_carbs_g REAL NOT NULL CHECK (total_carbs_g >= 0),
  total_fiber_g REAL NOT NULL CHECK (total_fiber_g >= 0),
  total_net_carbs_g REAL NOT NULL CHECK (total_net_carbs_g >= 0),
  total_fat_g REAL NOT NULL CHECK (total_fat_g >= 0),
  total_protein_g REAL NOT NULL CHECK (total_protein_g >= 0),
  total_calories_kcal REAL NOT NULL CHECK (total_calories_kcal >= 0),

  ingredients_count INTEGER NOT NULL DEFAULT 0 CHECK (ingredients_count >= 0),

  avg_quantity_confidence REAL CHECK (
    avg_quantity_confidence IS NULL OR
    (avg_quantity_confidence >= 0 AND avg_quantity_confidence <= 1)
  ),
  min_quantity_confidence REAL CHECK (
    min_quantity_confidence IS NULL OR
    (min_quantity_confidence >= 0 AND min_quantity_confidence <= 1)
  ),
  carb_weighted_quantity_confidence REAL CHECK (
    carb_weighted_quantity_confidence IS NULL OR
    (carb_weighted_quantity_confidence >= 0 AND carb_weighted_quantity_confidence <= 1)
  ),
  wbt_weighted_quantity_confidence REAL CHECK (
      wbt_weighted_quantity_confidence IS NULL OR
      (wbt_weighted_quantity_confidence >= 0 AND wbt_weighted_quantity_confidence <= 1)
  ),

  carb_weighted_nutrition_confidence REAL CHECK (
    carb_weighted_nutrition_confidence IS NULL OR
    (carb_weighted_nutrition_confidence >= 0 AND carb_weighted_nutrition_confidence <= 1)
  ),
  wbt_weighted_nutrition_confidence REAL CHECK (
      wbt_weighted_nutrition_confidence IS NULL OR
      (wbt_weighted_nutrition_confidence >= 0 AND wbt_weighted_nutrition_confidence <= 1)
  ),

  carb_weighted_effective_confidence REAL CHECK (
    carb_weighted_effective_confidence IS NULL OR
    (carb_weighted_effective_confidence >= 0 AND carb_weighted_effective_confidence <= 1)
  ),
  wbt_weighted_effective_confidence REAL CHECK (
      wbt_weighted_effective_confidence IS NULL OR
      (wbt_weighted_effective_confidence >= 0 AND wbt_weighted_effective_confidence <= 1)
  ),

  created_at INTEGER NOT NULL DEFAULT (CAST(strftime('%s','now') AS INTEGER) * 1000),
  updated_at INTEGER NOT NULL DEFAULT (CAST(strftime('%s','now') AS INTEGER) * 1000),

  is_synced BOOL NOT NULL DEFAULT 0,

  UNIQUE (meal_id, snapshot_type)
);

CREATE TRIGGER meal_snapshot_set_updated_at
AFTER UPDATE ON meal_snapshot
FOR EACH ROW
WHEN NEW.updated_at = OLD.updated_at
BEGIN
  UPDATE meal_snapshot
  SET updated_at = (CAST(strftime('%s','now') AS INTEGER) * 1000)
  WHERE id = NEW.id;
END;

CREATE TRIGGER meal_snapshot_any_change_marks_unsynced
AFTER UPDATE ON meal_snapshot
FOR EACH ROW
WHEN NEW.is_synced <> 0
BEGIN
  UPDATE meal_snapshot SET is_synced = 0 WHERE id = NEW.id;
END;