import 'ingredient.drift';
import 'portion.drift';

CREATE TABLE quick_low_treatment_item (
  id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,

  name TEXT NOT NULL,
  ingredient_id INTEGER NOT NULL
    REFERENCES ingredient(id) ON DELETE RESTRICT,
  portion_id INTEGER
    REFERENCES portion(id) ON DELETE SET NULL,

  amount REAL NOT NULL CHECK (amount > 0),
  sort_order INTEGER NOT NULL DEFAULT 0,
  is_active BOOL NOT NULL DEFAULT 1,

  created_at INTEGER NOT NULL DEFAULT (CAST(strftime('%s','now') AS INTEGER) * 1000),
  updated_at INTEGER NOT NULL DEFAULT (CAST(strftime('%s','now') AS INTEGER) * 1000),

  is_synced BOOL NOT NULL DEFAULT 0
);

CREATE TRIGGER quick_low_treatment_item_set_updated_at
AFTER UPDATE ON quick_low_treatment_item
FOR EACH ROW
WHEN NEW.updated_at = OLD.updated_at
BEGIN
  UPDATE quick_low_treatment_item
  SET updated_at = (CAST(strftime('%s','now') AS INTEGER) * 1000)
  WHERE id = NEW.id;
END;

CREATE TRIGGER quick_low_treatment_item_any_change_marks_unsynced
AFTER UPDATE ON quick_low_treatment_item
FOR EACH ROW
WHEN NEW.is_synced <> 0
BEGIN
  UPDATE quick_low_treatment_item SET is_synced = 0 WHERE id = NEW.id;
END;
