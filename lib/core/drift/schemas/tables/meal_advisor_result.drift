import 'meal.drift';

CREATE TABLE meal_advisor_result (
  meal_id INTEGER NOT NULL PRIMARY KEY
    REFERENCES meal(id) ON DELETE CASCADE,

  result TEXT NOT NULL,
  initial_wait_time INTEGER NOT NULL,
  final_wait_time INTEGER NOT NULL,
  wait_time_ignored BOOL NOT NULL,

  version INTEGER NOT NULL DEFAULT 1,

  is_synced BOOL NOT NULL DEFAULT 0,

  created_at INTEGER NOT NULL DEFAULT (CAST(strftime('%s','now') AS INTEGER) * 1000),
  updated_at INTEGER NOT NULL DEFAULT (CAST(strftime('%s','now') AS INTEGER) * 1000)
);

CREATE TRIGGER meal_advisor_result_set_updated_at
AFTER UPDATE ON meal_advisor_result
FOR EACH ROW
BEGIN
  UPDATE meal_advisor_result
  SET updated_at = CAST(strftime('%s','now') AS INTEGER) * 1000
  WHERE meal_id = OLD.meal_id;
END;

CREATE TRIGGER meal_advisor_result_any_change_marks_unsynced
AFTER UPDATE ON meal_advisor_result
FOR EACH ROW
WHEN NEW.is_synced <> 0
BEGIN
  UPDATE meal_advisor_result SET is_synced = 0 WHERE meal_id = NEW.meal_id;
END;

markMealAdvisorResultAsSynced:
  UPDATE meal_advisor_result SET
    is_synced = 1
    WHERE meal_id = :mealId;