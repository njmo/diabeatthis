CREATE TABLE activity (
  id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,

  name TEXT NOT NULL UNIQUE,
  percentage_pre INTEGER NOT NULL CHECK (percentage_pre >= 0 AND percentage_pre <= 100),
  percentage_post INTEGER NOT NULL CHECK (percentage_post >= 0 AND percentage_post <= 100),
  duration_minutes INTEGER CHECK (duration_minutes IS NULL OR duration_minutes > 0),

  is_synced BOOL NOT NULL DEFAULT 0,

  created_at INTEGER NOT NULL DEFAULT (CAST(strftime('%s','now') AS INTEGER) * 1000)
);

CREATE TRIGGER activity_any_change_marks_unsynced
AFTER UPDATE ON activity
FOR EACH ROW
WHEN NEW.is_synced <> 0
BEGIN
  UPDATE activity SET is_synced = 0 WHERE id = NEW.id;
END;

searchActivitiesByName:
  SELECT * FROM activity
  WHERE name LIKE '%' || :q || '%'
  ORDER BY name ASC
  LIMIT :limit;
