rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Family data is accessible only through authenticated, authorized callables.
    // No wildcard read/write permission may be added around these namespaces.
    match /families/{document=**} { allow read, write: if false; }
    match /familyJoinRequests/{document=**} { allow read, write: if false; }
    match /familyAccounts/{document=**} { allow read, write: if false; }
    match /pairingInvites/{document=**} { allow read, write: if false; }
    match /familyRateLimits/{document=**} { allow read, write: if false; }
    match /familyDevices/{document=**} { allow read, write: if false; }
    match /familyNotificationJobs/{document=**} { allow read, write: if false; }
    // Other application data also stays closed in this standalone ruleset.
    match /{document=**} { allow read, write: if false; }
  }
}
